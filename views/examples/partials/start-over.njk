{#- Demo only: the "Start over" button in the action row of every Form Library page except fill-together. The example script binds #start-over. #}
<button id="start-over" type="button"{% if initiallyDisabled %} disabled{% endif %} class="box-border inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-md border border-gray-300 bg-white px-3 text-sm font-semibold text-gray-700 [font-family:inherit] hover:bg-gray-100 disabled:opacity-50">
    <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 4 3 10 9 10"/><path d="M3.5 15a9 9 0 1 0 2.1-9.4L3 10"/></svg>
    Start over
</button>
