{% extends "layouts/example.njk" %}
{#- "Open saved form" (?form) renders the saved definition with the Form Library, so it loads the form theme #}
{% set theme = "survey" if formMode else "creator" %}
{% set hasActions = true %}

{% block description %}
    <p>Load form JSON schemas from your backend into Survey Creator and save changes automatically. The backend checks each user's permission to save, so users without save access can edit locally while the stored schema stays unchanged.</p>
{% endblock %}

{% block try %}
    <li>As <strong>Alice</strong>, change the form title or a question in the Designer. The status above the editor confirms when the backend has saved your changes.</li>
    <li>Switch <strong>Demo user</strong> to <strong>Bob</strong> and edit the form. You can make changes locally, but the backend rejects attempts to save them.</li>
    <li>Press <strong>Open saved form</strong> to view the saved version in a new tab. Alice's pending changes are saved first; Bob opens the version already stored on the server.</li>
    <li>Open <strong>Requests</strong> to inspect the loaded schema and save requests. As Alice, you can press <strong>Restore sample</strong> to replace the saved schema with the original example.</li>
{% endblock %}

{% block demo_user_control %}
    <label class="flex items-center gap-2">
        <span class="text-gray-600">Demo user</span>
        <select id="demo-user" class="box-border h-9 rounded-md border border-gray-300 bg-white px-2 text-sm">
            <option value="alice"{% if user.email == "alice@example.com" %} selected{% endif %}>Alice (can save schemas)</option>
            <option value="bob"{% if user.email == "bob@example.com" %} selected{% endif %}>Bob (cannot save schemas)</option>
        </select>
    </label>
{% endblock %}

{% block actions %}
    {% if formMode %}
        <a id="back-to-editor" href="?" class="text-sjs-dark underline">Back to editor</a>
    {% else %}
    <a id="open-saved-form" aria-disabled="true" href="?form" target="_blank" class="box-border inline-flex h-9 items-center gap-1.5 rounded-md border border-gray-300 bg-white px-3 text-sm font-semibold text-gray-700 no-underline hover:bg-gray-100 aria-disabled:opacity-50">
        Open saved form
        <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
    </a>
    <button id="restore-sample" type="button" disabled class="h-9 cursor-pointer rounded-md border border-gray-300 bg-white px-3 text-sm font-semibold hover:bg-gray-100 disabled:opacity-50">Restore sample</button>
    {% endif %}
{% endblock %}

{% block form %}
    <div class="flex flex-wrap items-center gap-3 border-b border-gray-200 p-4 text-sm">
        <p data-show="schema-status" role="status" aria-live="polite" class="m-0 flex-1 text-gray-700">Loading the saved form...</p>
        <button id="retry-load" type="button" hidden class="h-9 cursor-pointer rounded-md border border-gray-300 bg-white px-3 font-semibold hover:bg-gray-100">Retry loading</button>
        <button id="retry-save" type="button" hidden class="h-9 cursor-pointer rounded-md border border-gray-300 bg-white px-3 font-semibold hover:bg-gray-100 disabled:opacity-50">Try saving again</button>
    </div>
    {#- ?form renders a form here: it takes the form's padding instead of Creator's height #}
    <div id="creator" hidden inert class="{{ 'p-4 sm:p-6' if formMode else 'h-[calc(100dvh_-_var(--header-h,3.5rem)_-_var(--tabs-h,3.5rem)_-_var(--demo-above,1rem)_-_1.5rem)] min-h-[640px]' }}"></div>
{% endblock %}
