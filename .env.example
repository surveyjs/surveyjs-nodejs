# Copy to .env (`npm run setup` does it). .env is git-ignored and holds only the private keys: everything else is in
# settings.env, which is committed. Values here win over settings.env; variables set in the environment win over both.

# Commercial examples (Dashboard, Creator, Generate PDFs) run without a key and show a licence banner.
# Set, it applies to the pages and, because survey-pdf runs in this process, to server PDFs as well.
SURVEYJS_LICENSE_KEY=

# Extract Responses from Documents: the extractor's key (the provider and model are in settings.env)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Translate with AI: the key for the endpoint in settings.env (AI_BASE_URL). Without it, /api/translate answers 501.
AI_API_KEY=
