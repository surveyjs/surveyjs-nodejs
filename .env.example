# Copy to .env: `npm start` and `npm run dev` load it with Node's own --env-file-if-exists. Variables already set in
# the environment win. config.js reads every setting once; no other file reads process.env.

# Where the app listens. APP_PORT wins over PORT (which Azure App Service and Heroku set); the default is 8000.
# The host is APP_HOST, else 0.0.0.0 when PORT is set, else 127.0.0.1. `npm start` refuses a port something answers on.
APP_PORT=8000
# APP_HOST=127.0.0.1
# NODE_ENV=production

# The SQLite database, uploads, visitor sandboxes and relay snapshots (default: storage/)
# DATA_DIR=storage

# Commercial examples (Dashboard, Creator, Generate PDFs) run without a key and show a licence banner.
# Set, it applies to the pages and, because survey-pdf runs in this process, to server PDFs as well.
SURVEYJS_LICENSE_KEY=

# Run Server-Side Workflows run in this app with the SurveyJS libraries: no service to start.
# routes/validate-response.js replaces routes/save-response.js
VALIDATE_RESPONSES=false
# routes/lint-definition.js replaces the PUT in routes/creator-load-save.js
LINT_DEFINITIONS=false

# Extract Responses from Documents: the extractor's AI provider (openai, anthropic or ollama). Without
# SURVEYJS_AI_PROVIDER the provider whose key is set is used. SURVEYJS_AI_MODEL is optional (the provider's default).
SURVEYJS_AI_PROVIDER=
SURVEYJS_AI_MODEL=
SURVEYJS_OLLAMA_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Translate with AI: any OpenAI-compatible /chat/completions endpoint. Without a key, /api/translate answers 501.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# The relays run in this app, on its port, at /ws/rooms/<id> and /ws/forms/<id>. Leave these empty to use the page's
# own origin (ws or wss as the visitor sees it); set them to a proxy's origin, e.g. wss://example.com, when it serves
# /ws/ on another host.
RELAY_URL=
EDIT_RELAY_URL=

# Demo only: a private database copy per visitor, removed after 24 hours unused (the hosted demo)
DEMO_MODE=false

# Which checkout answered: `<branch>@<commit>`, shown on the pages as "Running …". Unset, the app asks git once.
# SURVEYJS_BUILD=

# Where the pages link: the docs page (each example adds #<anchor>) and the repository (View on GitHub)
# SURVEYJS_DOCS=https://surveyjs.io/documentation/backend-integration-express
# SURVEYJS_GITHUB=https://github.com/surveyjs/surveyjs-nodejs
