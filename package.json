{
  "name": "surveyjs-nodejs",
  "version": "2.0.0",
  "private": true,
  "description": "The Node.js code behind the SurveyJS backend integration docs: 18 examples on Express 5",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=settings.env --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file=settings.env --env-file-if-exists=.env server.js",
    "setup": "node scripts/setup.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:browser": "playwright test",
    "check": "node --env-file=settings.env --env-file-if-exists=.env scripts/check.mjs",
    "contract": "node scripts/contract.mjs",
    "readme": "node scripts/readme.mjs",
    "css": "tailwindcss -i styles/site.css -o public/css/site.css --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surveyjs/surveyjs-nodejs-express.git"
  },
  "keywords": [
    "survey",
    "surveyjs",
    "nodejs",
    "express",
    "survey-creator",
    "survey-analytics",
    "form-builder"
  ],
  "author": "SurveyJS",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/surveyjs/surveyjs-nodejs-express/issues"
  },
  "homepage": "https://github.com/surveyjs/surveyjs-nodejs-express#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "~0.90.0",
    "ai-form-response-extractor": "^0.2.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nunjucks": "3.2.4",
    "openai": "^6.49.0",
    "sharp": "~0.33.5",
    "survey-analytics": "3.2.7",
    "survey-core": "3.2.7",
    "survey-creator-core": "3.2.7",
    "survey-creator-js": "3.2.7",
    "survey-js-ui": "3.2.7",
    "survey-pdf": "3.2.7",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
